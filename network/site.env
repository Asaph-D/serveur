## Configuration “site” — pare-feu, WebRTC, monitoring
#
# Adresses LAN (IP, CIDR, passerelle) : network/global-config.env
# Après changement de réseau :
#   bash scripts/sync-global-config.sh
#   sudo bash scripts/net-apply-site.sh
#

GCFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$GCFG_DIR/global-config.env"

WEBRTC_WSS_PORT="${PROVISION_WSS_PORT:-8089}"

# MGMT_CIDR, EXTRA_LAN_CIDRS, PBX_MDNS_NAME, VOICE_CIDR → global-config.env

# Ouvrir aussi SIP/RTP depuis le LAN de gestion (utile si tes softphones sont sur MGMT_CIDR)
ALLOW_SIP_FROM_MGMT="yes"

# Ouvrir TLS 5061 depuis MGMT_CIDR (utile si tes clients utilisent TLS depuis le LAN de gestion)
ALLOW_TLS_FROM_MGMT="yes"

# --- Monitoring (Docker) ---
MONITORING_ENABLE="yes"
MONITORING_ALLOW_FROM_MGMT="yes"
GRAFANA_PORT="3000"
INFLUXDB_PORT="8086"

# --- WebRTC (navigateur / WSS) ---
WEBRTC_ENABLE="yes"
WEBRTC_HTTP_PORT="8088"
WEBRTC_WSS_PORT="8089"
