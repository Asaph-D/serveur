## Configuration trunks SIP (PSTN + inter-PBX)
#
# Appliquer :
#   sudo bash /home/asaph/Documents/serveur/scripts/apply-trunks.sh
#
# Secrets (non versionnés) :
#   sudo cp network/trunks.secrets.env.example /root/trunks-secrets.env
#   sudo chmod 600 /root/trunks-secrets.env
#

TRUNKS_ENABLE="yes"

# --- Trunk opérateur PSTN (sortant/entrant vers réseau public) ---
PSTN_TRUNK_NAME="trunk-operateur-pstn"
PSTN_TRUNK_CHANNELID="trunk-operateur-pstn"
PSTN_SIP_SERVER="sip.ovh.fr"
PSTN_SIP_PORT="5060"
PSTN_TRANSPORT="0.0.0.0-udp"
PSTN_REGISTRATION="send"
PSTN_AUTHENTICATION="outbound"
PSTN_CONTEXT="from-pstn"
PSTN_CODECS="ulaw,alaw,g722"
# IP(s) signalisation opérateur pour UFW (espaces = plusieurs). Ex: "51.68.0.0/16"
PSTN_OPERATOR_CIDRS=""
PSTN_OUTCID=""

# --- Trunk inter-PBX (autre site avec son propre PBX) ---
INTERPBX_TRUNK_NAME="trunk-interpbx-site-b"
INTERPBX_CHANNELID="trunk-interpbx-site-b"
INTERPBX_REMOTE_HOST=""
# IP/CIDR du PBX distant (LAN ou VPN). Active le trunk inter-PBX en mode réception.
INTERPBX_MATCH_IP="192.168.1.0/24 10.200.0.0/24"
INTERPBX_SIP_PORT="5060"
INTERPBX_TRANSPORT="0.0.0.0-udp"
INTERPBX_REGISTRATION="receive"
INTERPBX_AUTHENTICATION="inbound"
INTERPBX_CONTEXT="from-pstn"
INTERPBX_PREFIX="8"

# --- Routes sortantes ---
ROUTE_FRANCE_NAME="France-metropole"
ROUTE_INTERNATIONAL_NAME="International"
ROUTE_INTERPBX_NAME="Inter-PBX-site-B"

# --- Routes entrantes ---
INBOUND_DEFAULT_DEST="from-internal,7000,1"
INBOUND_DID=""
INBOUND_DID_DESCRIPTION="DID opérateur principal"
INBOUND_CATCHALL_DESCRIPTION="Appels entrants trunk (catch-all)"
