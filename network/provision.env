## Politique provisionnement Asaphone (onboarding self-service)
#
# Adresses volatiles (LAN, tunnel, bootstrap) : network/global-config.env
#   bash scripts/sync-global-config.sh [--deploy]
#
# Voir : security/asaphone-onboarding-flow.md
#

GCFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$GCFG_DIR/global-config.env"

PROVISION_ENABLE="yes"
PROVISION_POLICY="auto"
PROVISION_EXT_POOL="1003 1004 1005 1006 1007 1008 1009 1010"
PROVISION_VERIFY_TTL="900"
PROVISION_QR_TTL="86400"

# Serveur SIP affiché dans le QR / mail (nom mDNS stable) — valeurs littérales pour PHP
PROVISION_PBX_HOST="pbx.local"
PROVISION_WSS_PORT="8089"
PROVISION_TRANSPORT="wss"
PROVISION_BASE_URL="https://pbx.local/provision"

PROVISION_MAIL_FROM="noreply@asaphone.com"
PROVISION_MAIL_SUBJECT="Vos identifiants Asaphone"
PROVISION_MAIL_VERIFY_SUBJECT="Code de vérification Asaphone"

# Discovery + API distante → global-config.env (fusionnée par config.php)

PROVISION_QR_SCHEME="asaphone"
PROVISION_RATE_LIMIT_REGISTER="5"
PROVISION_RATE_LIMIT_VERIFY="10"

PROVISION_SECRETS_FILE="/etc/provision/provision-secrets.env"
PROVISION_MASTER_KEY_FILE="/etc/provision/master.key"
PROVISION_PJSIP_SECRETS="/root/phase2-pjsip-secrets.txt"
PROVISION_CODECS="g722,ulaw,alaw,opus"
PROVISION_VIDEO_CODECS="vp8,h264"
PROVISION_VM_CODE_PREFIX="*81"
PROVISION_VM_NOTIFY_TTL="604800"

# --- VPN WireGuard (auto-provisionnement) ---
PROVISION_VPN_ENABLE="yes"
# open = connexion sans compte : enroll(device_id) → claim → tunnel (api_remote)
PROVISION_VPN_CONNECT_MODE="open"
PROVISION_VPN_TUNNEL_PREFIX="10.200.0"
PROVISION_VPN_POOL_START="10"
PROVISION_VPN_POOL_END="254"
PROVISION_VPN_PORT="${PROVISION_VPN_PORT:-51820}"
PROVISION_VPN_CLAIM_TTL="86400"
PROVISION_VPN_MAIL_SUBJECT="Configuration VPN Asaphone"
PROVISION_VPN_SERVER_PUBKEY_FILE="/etc/wireguard/server.pub"

# >>> AUTO-GENERATED — sync-global-config.sh
PROVISION_PUBLIC_HOST="gauge-mia-organisations-rather.trycloudflare.com"
PROVISION_PUBLIC_BASE_URL="https://gauge-mia-organisations-rather.trycloudflare.com/provision"
PROVISION_VPN_LAN_IP="192.168.1.80"
PROVISION_VPN_LAN_ENDPOINT="192.168.1.80:51820"
PROVISION_VPN_DNS="192.168.1.1"
PROVISION_VPN_ALLOWED_IPS="192.168.1.0/24,10.10.10.0/24,10.200.0.0/24"
PROVISION_VPN_PUBLIC_ENDPOINT="143.105.152.114:51820"
PROVISION_REMOTE_ACCESS_MODE="wss-relay"
PROVISION_WG_REMOTE_ENABLE="no"
PROVISION_WG_RELAY_PATH_PREFIX="9e360c3e6e7d3d3bf37da55b"
PROVISION_WG_RELAY_WSS_URL="wss://timely-chip-fabrics-patent.trycloudflare.com"
# <<< AUTO-GENERATED
