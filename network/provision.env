## Politique provisionnement Asaphone (onboarding self-service)
#
# Voir : security/asaphone-onboarding-flow.md
#

# Activer le module provisionnement
PROVISION_ENABLE="yes"

# Politique d'attribution d'extension :
#   admin          = admin valide avant envoi QR
#   auto           = prochaine extension libre du pool
#   preprovisioned = extension déjà créée avec cet e-mail
PROVISION_POLICY="auto"

# Pool d'extensions auto (si PROVISION_POLICY=auto)
PROVISION_EXT_POOL="1003 1004 1005 1006 1007 1008 1009 1010"

# Durées (secondes)
PROVISION_VERIFY_TTL="900"
PROVISION_QR_TTL="86400"

# Serveur SIP affiché dans le QR / mail
PROVISION_PBX_HOST="pbx.local"
PROVISION_WSS_PORT="8089"
PROVISION_TRANSPORT="wss"

# E-mail (SMTP — secrets dans /root/provision-secrets.env)
PROVISION_MAIL_FROM="noreply@asaphone.com"
PROVISION_MAIL_SUBJECT="Vos identifiants Asaphone"
PROVISION_MAIL_VERIFY_SUBJECT="Code de vérification Asaphone"

# URL base mini-API (HTTPS) — LAN / mDNS
PROVISION_BASE_URL="https://pbx.local/provision"

# Bootstrap Internet — découverte fixe (GitHub Pages, toujours joignable)
PROVISION_DISCOVERY_URL="https://asaph-d.github.io/Portfolio/provision/bootstrap.json"

# API distante — reverse proxy Cloudflare Tunnel (pas de box / port-forward)
# Généré/mis à jour : sudo bash scripts/install-provision-tunnel.sh
PROVISION_PUBLIC_HOST="advance-associates-brakes-reducing.trycloudflare.com"
PROVISION_PUBLIC_BASE_URL="https://advance-associates-brakes-reducing.trycloudflare.com/provision"

# Schéma QR scanné par Asaphone (URL claim one-shot)
PROVISION_QR_SCHEME="asaphone"

# Rate-limit inscriptions (par IP / e-mail, fenêtre 1 h)
PROVISION_RATE_LIMIT_REGISTER="5"
PROVISION_RATE_LIMIT_VERIFY="10"

# Fichiers système (hors Git)
PROVISION_SECRETS_FILE="/etc/provision/provision-secrets.env"
PROVISION_MASTER_KEY_FILE="/etc/provision/master.key"
PROVISION_PJSIP_SECRETS="/root/phase2-pjsip-secrets.txt"

# Codecs affichés dans le payload claim
PROVISION_CODECS="g722,ulaw,alaw"

# Code messagerie directe : *81 + 3 derniers chiffres (1003 → *81003)
PROVISION_VM_CODE_PREFIX="*81"

# Notification messagerie : SIP MESSAGE vers Asaphone (même flux que le chat)
PROVISION_VM_NOTIFY_TTL="604800"

# --- VPN WireGuard (auto-provisionnement, OPTIONNEL) ---
# Recommandé surtout hors réseau site (4G, autre box, télétravail).
# Sur MGMT_CIDR (ex. 192.168.137.0/24) : Asaphone peut joindre pbx.local sans VPN.
# Le SIP/WSS et le VPN sont indépendants — pas de VPN requis pour s'enregistrer sur le LAN.
PROVISION_VPN_ENABLE="yes"
PROVISION_VPN_TUNNEL_PREFIX="10.200.0"
PROVISION_VPN_POOL_START="10"
PROVISION_VPN_POOL_END="254"
PROVISION_VPN_PORT="51820"
PROVISION_VPN_PUBLIC_ENDPOINT="143.105.152.123:51820"
PROVISION_VPN_LAN_IP="192.168.137.240"
PROVISION_VPN_LAN_ENDPOINT="192.168.137.240:51820"
PROVISION_VPN_ALLOWED_IPS="192.168.137.0/24,10.10.10.0/24,10.200.0.0/24"
PROVISION_VPN_DNS="192.168.137.1"
PROVISION_VPN_CLAIM_TTL="86400"
PROVISION_VPN_MAIL_SUBJECT="Configuration VPN Asaphone"
PROVISION_VPN_SERVER_PUBKEY_FILE="/etc/wireguard/server.pub"
