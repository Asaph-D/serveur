# Extensions PJSIP : alignement codecs / WebRTC (cf. scripts/align-pjsip-site.sh)
#
# Exécuter sur le PBX :
#   sudo bash /home/asaph/Documents/serveur/scripts/align-pjsip-site.sh
#
# Postes navigateur / WSS : liste d’extensions (séparées par espaces).
WEBRTC_EXTENSIONS="1003 1004 1005 1006 1007 1008 1009 1010"

# Postes classiques (UDP, téléphones, Zoiper…) : espaces = plusieurs.
CLASSIC_EXTENSIONS="1001 1002"

# Codecs (séparateur virgule ; en base FreePBX → &)
# WebRTC : opus + vp8/h264 pour appels vidéo navigateur / Asaphone
WEBRTC_CODEC_ALLOW="g722,ulaw,alaw,opus,vp8,h264"
CLASSIC_CODEC_ALLOW="g722,ulaw,alaw"
