## Secrets provisionnement Asaphone — copier vers /etc/provision/provision-secrets.env (chmod 640, root:www-data)
## Ne pas committer le fichier rempli.

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASSWORD=your-app-password
# Placeholder futur (domaine pro) — non utilisé pour l'envoi ; expéditeur réel = EMAIL_USER
EMAIL_FROM=noreply@asaphone.com
EMAIL_ENABLED=true

# Token GitHub (PAT scope repo) — publication auto bootstrap.json sur Portfolio
# GITHUB_TOKEN=ghp_xxxxxxxx

# Secret coturn (use-auth-secret) — généré par scripts/install-coturn.sh si absent
# PROVISION_TURN_SECRET=
