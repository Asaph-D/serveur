## Configuration globale — adresses volatiles et réseau LAN
#
# Source unique pour site.env, provision.env et bootstrap.json (GitHub Pages).
#
# Sans domaine propre : tunnel Cloudflare quick + publication auto bootstrap GitHub.
# Avec domaine (zone Cloudflare) : CLOUDFLARE_TUNNEL_MODE=named + PROVISION_PUBLIC_HOST
#
# Après changement de Wi-Fi :
#   bash scripts/sync-global-config.sh
#   sudo bash scripts/net-apply-site.sh

# Interface DHCP du réseau LAN où les clients (et le VPN endpoint_lan) joignent le PBX.
# Par défaut = MGMT_IFACE. IP détectée → pbx_lan_ip / sip_server dans bootstrap + claim SIP.
MGMT_IFACE="ens33"
VPN_LAN_IFACE="ens33"

# Nom stable côté téléphones (mDNS → pbx.local)
PBX_MDNS_NAME="pbx"
PBX_HOST="pbx.local"

# VLAN voix fixe sur le serveur (ens33.10)
VOICE_CIDR="10.10.10.0/24"
EXTRA_VOICE_CIDRS=""

# Sous-réseau WireGuard (clients distants)
VPN_TUNNEL_CIDR="10.200.0.0/24"
PROVISION_VPN_PORT="51820"

# Accès distant hors LAN : tailscale (Starlink CGNAT) | wireguard (port forward UDP)
PROVISION_REMOTE_ACCESS_MODE="auto"
PROVISION_WSS_PORT="8089"

# WebRTC vidéo + relais ICE (coturn sur le PBX)
WEBRTC_VIDEO_ENABLE="yes"
PROVISION_TURN_ENABLE="yes"
PROVISION_TURN_PORT="3478"
PROVISION_TURN_TLS_PORT="5349"
PROVISION_TURN_RELAY_MIN="49160"
PROVISION_TURN_RELAY_MAX="49200"

# --- Découverte fixe (GitHub Pages — toujours la même URL) ---
PROVISION_DISCOVERY_URL="https://asaph-d.github.io/Portfolio/provision/bootstrap.json"

# Publication auto du bootstrap après chaque boot (api_remote trycloudflare → GitHub)
GITHUB_BOOTSTRAP_PUBLISH="yes"
GITHUB_BOOTSTRAP_REPO="asaph-d/Portfolio"
GITHUB_BOOTSTRAP_BRANCH="main"
GITHUB_BOOTSTRAP_PATH="provision/bootstrap.json"
# Publication miroir optionnelle dans le dépôt serveur (network/github-pages/…)
GITHUB_TOKEN_FILE="/etc/provision/github-token"
GITHUB_BOOTSTRAP_MIRROR_REPO="asaph-d/serveur"
GITHUB_BOOTSTRAP_MIRROR_PATH="network/github-pages/provision/bootstrap.json"

# --- API distante : tunnel Cloudflare ---
# quick  = trycloudflare (gratuit, sans domaine) — URL change au reboot → bootstrap republié sur GitHub
# named  = domaine fixe sur zone Cloudflare — voir scripts/install-provision-tunnel.sh
CLOUDFLARE_TUNNEL_MODE="quick"
CLOUDFLARE_TUNNEL_NAME="asaphone-provision"
# Uniquement si CLOUDFLARE_TUNNEL_MODE=named (zone DNS Cloudflare)
PROVISION_PUBLIC_HOST=""

# >>> AUTO-GENERATED — ne pas éditer (sync-global-config.sh / serveur-startup)
PBX_LAN_IP="192.168.10.7"
MGMT_CIDR="192.168.10.0/24"
MGMT_GW="192.168.10.1"
PUBLIC_IP="143.105.152.206"
PROVISION_VPN_PUBLIC_ENDPOINT="143.105.152.206:51820"
EXTRA_LAN_CIDRS="192.168.10.0/24 10.200.0.0/24"
PROVISION_VPN_LAN_IP="192.168.10.7"
PROVISION_VPN_LAN_ENDPOINT="192.168.10.7:51820"
PROVISION_VPN_DNS="192.168.10.1"
PROVISION_VPN_ALLOWED_IPS="192.168.10.0/24,10.10.10.0/24,10.200.0.0/24"
PROVISION_REMOTE_ACCESS_MODE="wss-relay"
PROVISION_WG_REMOTE_ENABLE="yes"
# <<< AUTO-GENERATED
