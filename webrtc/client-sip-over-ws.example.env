# Copier vers .env local de ton appli web (ou injecter en CI).
# Hôte mDNS du PBX (cf. network/site.env → PBX_MDNS_NAME + avahi).
#
# Tout client SIP over WebSocket (navigateur) doit au minimum connaître l’URL WSS ci-dessous.

# Signalisation SIP sur WebSocket (TLS) — à utiliser en production navigateur
SIP_WEBSOCKET_URL=wss://pbx.local:8089/ws

# Option lab uniquement (pas de TLS) — nécessite une page web en http:// (mixed content si HTTPS)
# SIP_WEBSOCKET_URL=ws://pbx.local:8088/ws

# Domaine / realm SIP (souvent identique au host ; à aligner sur l’extension FreePBX)
SIP_DOMAIN=pbx.local

# Exemple d’URI SIP enregistrée côté client (remplacer 1000 par l’extension)
# SIP_URI=sip:1000@pbx.local
