[Unit]
Description=Cloudflare Tunnel — reverse proxy provision Asaphone (sans port-forward)
After=network-online.target apache2.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:80 --http-host-header pbx.local
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/provision/cloudflared.log
StandardError=append:/var/log/provision/cloudflared.log

[Install]
WantedBy=multi-user.target
