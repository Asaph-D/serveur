[Unit]
Description=Cloudflare Tunnel nommé — API provision Asaphone (domaine fixe)
After=network-online.target apache2.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --config /etc/cloudflared/provision/config.yml run
Restart=on-failure
RestartSec=10
StandardOutput=append:/var/log/provision/cloudflared.log
StandardError=append:/var/log/provision/cloudflared.log

[Install]
WantedBy=multi-user.target
