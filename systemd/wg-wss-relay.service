[Unit]
Description=WireGuard UDP relay over WebSocket (Asaphone / Starlink)
After=network-online.target wg-quick@wg0.service apache2.service
Wants=network-online.target

[Service]
Type=simple
User=nobody
Group=nogroup
EnvironmentFile=-/etc/provision/wg-relay.env
ExecStart=/usr/local/bin/wstunnel server \
	--restrict-http-upgrade-path-prefix @PATH_PREFIX@ \
	--restrict-to 127.0.0.1:@WG_PORT@ \
	ws://127.0.0.1:@RELAY_PORT@
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
